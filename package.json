{
  "description": "Magpie gateway hook: folds long Codex sessions with Codex's own compaction before a provider's user-message / model-turn cap rejects them.",
  "magpie": {
    "hooks": "turn-guard.hooks.js",
    "middleware": "turn-guard.gateway.js",
    "name": "turn-guard",
    "options": {
      "compactModel": "",
      "compactReasoningEffort": "low",
      "compactTimeoutMs": 270000,
      "gatewayTimeoutMs": 30000,
      "gatewayUrl": "http://127.0.0.1:3425/v1",
      "keepRecentTurns": 20,
      "keepRecentUsers": 3,
      "providers": [
        "xingchi"
      ],
      "retryCooldownMs": 15000,
      "turnCap": 100,
      "turnThreshold": 90,
      "userCap": 20,
      "userThreshold": 18
    }
  },
  "license": "MIT",
  "name": "turn-guard",
  "private": false,
  "scripts": {
    "test": "bun scripts/test-hook-compaction.js"
  },
  "version": "2.4.0"
}
